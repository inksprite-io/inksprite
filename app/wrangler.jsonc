// The app on Cloudflare: Workers Builds runs `npm ci && npm run build` in app/
// and then `npx wrangler deploy`, which serves the build in dist. A request for
// a file is answered with it, free; only a path that isn't a file runs
// worker.js, which answers an address in the app with index.html, as a
// single-page app needs, and a missing file under /assets/ with a 404. The
// headers are in public/_headers. The domain (app.inksprite.io) is set on the
// Worker in Cloudflare's dashboard.
{
  "name": "inksprite",
  "main": "worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "none",
  },
}
