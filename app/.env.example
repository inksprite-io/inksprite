# Copy to .env.local and fill in to offer Import › Google Drive… on a
# folder's menu. Without its client, the item is not there. They come from a
# Google Cloud project of your own, with the Google Picker API enabled:
#
# - A Web application client, whose authorized redirect URIs are
#   <each address the app runs at>/connect/google.
# - A Desktop app client, for the desktop window. Its secret ships in the
#   app; Google does not count a desktop app's secret as one.
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_ID=
VITE_GOOGLE_DESKTOP_CLIENT_SECRET=

# Features merged but not yet released, by their names in PREVIEWS
# (src/config/preview.js), or all. The test server reads this file when it
# is made, so run ./rebuild-test-server.sh after a change; the Mac dev build
# reads it when it is built.
VITE_PREVIEW=

# true for what is only for developing inksprite and never released
# (src/config/dev.js): choosing the sync server. Read as VITE_PREVIEW is.
VITE_DEV_FEATURES=
