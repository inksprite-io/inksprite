{
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.80", "--browser", "chromium", "--headless"]
    },
    "playwright-webkit": {
      "command": "npx",
      "args": ["-y", "@playwright/mcp@0.0.80", "--browser", "webkit", "--headless"]
    },
    "chrome-devtools": {
      "command": "npx",
      "args": [
        "-y",
        "chrome-devtools-mcp@1.9.0",
        "--headless",
        "--executablePath",
        "/usr/local/bin/chromium-playwright"
      ]
    }
  }
}
